---
import { SEO } from "astro-seo";
import { ArrowUpRightIcon } from "@phosphor-icons/react";
import { ThemeToggle } from "../components/ThemeToggle";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  wrapperClass?: string;
}

const { title, description, wrapperClass = "mb-1" } = Astro.props;

let clacks = 0;
try {
  const response = await fetch(new URL('/api/tap-counter', Astro.url));
  if (response.ok) {
    const data = await response.json();
    clacks = data.count ?? 0;
  }
} catch {
  clacks = 0;
}
---

