	</body>
  <div class="h-1 md:h-25"></div>
</html>

<script>
  import dayjs from "dayjs";

  const clock = document.getElementById("clock");
  let prev = { hh: "", mm: "", ss: "" };

  function part(val, changed) {
    const cls = changed ? "clock-part" : "clock-static";
    return `<span class="${cls}">${val}</span>`;
  }

  function update() {
    const now = dayjs();
    const hh = now.format("HH");
    const mm = now.format("mm");
    const ss = now.format("ss");

    clock.innerHTML =
      part(hh, hh !== prev.hh) +
      `<span>:</span>` +
      part(mm, mm !== prev.mm) +
      `<span>:</span>` +
      part(ss, ss !== prev.ss);

    prev = { hh, mm, ss };
  }

  update();
  setInterval(update, 1000);
</script>

<script>
const ASCII = ['/', '\\', '|', '*', '#', '+', '~', '>', '<', '!', '@', '%', '1','0', ']', '?'];

const canvas = document.createElement('canvas');
canvas.style.cssText =
  'position:fixed;top:0;left:0;pointer-events:none;z-index:9999;';
document.body.appendChild(canvas);

const ctx = canvas.getContext('2d');
let particles = [];

function resize() {
  canvas.width = innerWidth;
  canvas.height = innerHeight;
}

resize();
window.addEventListener('resize', resize);

function spawnBurst(x, y, count = 20) {
  for (let i = 0; i < count; i++) {
    const angle =
      (Math.PI * 2 / count) * i + (Math.random() - 0.5) * 0.6;

    const speed = 2.5 + Math.random() * 3.5;

    particles.push({
      x,
      y,
      vx: Math.cos(angle) * speed,
      vy: Math.sin(angle) * speed - 1.5,
      char: ASCII[Math.floor(Math.random() * ASCII.length)],
      opacity: 1,
      size: 11 + Math.random() * 9,
    });
  }
}

document.addEventListener('click', (e) => {
  spawnBurst(e.clientX, e.clientY);
});

(function loop() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  particles = particles.filter((p) => p.opacity > 0);

  const isDark = document.documentElement.classList.contains('dark');

  for (const p of particles) {
    ctx.globalAlpha = p.opacity;
    ctx.fillStyle = isDark ? '#A8C06A' : '#2A008D';
    ctx.font = `${Math.round(p.size)}px monospace`;

    ctx.fillText(p.char, p.x, p.y);

    p.x += p.vx;
    p.y += p.vy;
    p.vy += 0.13;
    p.opacity -= 0.021;
  }

  ctx.globalAlpha = 1;
  requestAnimationFrame(loop);
})();
</script>

<script>
  const clacksEl = document.getElementById('clacks-display');
  
  const OPTIMISTIC_KEY = "face-tap-counter-optimistic";
  const FALLBACK_KEY = "face-tap-counter-local";
  const FLUSH_INTERVAL_MS = 30_000;
  const MAX_BATCH_SIZE = 20;

  let currentClacks = Number(clacksEl?.textContent?.trim() ?? 0);
  let pendingTaps = 0;
  let flushInProgress = false;
  let flushTimerId = null;
  let counterEnabled = true;
  let hasLoaded = false;

  function readOptimistic() {
    try {
      const n = Number(localStorage.getItem(OPTIMISTIC_KEY));
      return Number.isFinite(n) && n >= 0 ? n : 0;
    } catch { return 0; }
  }

  function writeOptimistic(count) {
    try { localStorage.setItem(OPTIMISTIC_KEY, String(count)); } catch {}
  }

  function clearOptimistic() {
    try { localStorage.removeItem(OPTIMISTIC_KEY); } catch {}
  }

  function readFallback() {
    try {
      const n = Number(localStorage.getItem(FALLBACK_KEY));
      return Number.isFinite(n) && n >= 0 ? n : 0;
    } catch { return 0; }
  }

  function animateClacks(newVal) {
    if (!clacksEl) return;

    const oldStr = String(currentClacks).padStart(String(newVal).length, '0');
    const newStr = String(newVal);

    clacksEl.innerHTML = newStr
      .split('')
      .map((char, i) => {
        const changed = char !== oldStr[i];
        return `<span class="${changed ? 'clock-part' : 'clock-static'}">${char}</span>`;
      })
      .join('');

    currentClacks = newVal;
  }

  async function loadCount() {
    try {
      const res = await fetch('/api/tap-counter', {
        headers: { Accept: 'application/json' }
      });

      if (!res.ok) throw new Error();

      const data = await res.json();
      counterEnabled = data.configured !== false;

      if (!counterEnabled) {
        animateClacks(readFallback());
        return;
      }

      if (typeof data.count === 'number') {
        const optimistic = readOptimistic();
        const display = Math.max(data.count, optimistic);
        animateClacks(display);
        clearOptimistic();
      }
    } catch {
      counterEnabled = false;
      animateClacks(readFallback());
    } finally {
      hasLoaded = true;
    }
  }

  async function flushTaps(force = false) {
    if (!counterEnabled || flushInProgress || pendingTaps < 1) return;

    const amount = pendingTaps;
    pendingTaps = 0;
    flushInProgress = true;

    try {
      const res = await fetch('/api/tap-counter', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify({ interaction: 'tap', amount }),
        keepalive: force,
      });

      if (res.status === 429) {
        counterEnabled = false;
        setTimeout(() => { counterEnabled = true; }, 60_000);
        return;
      }

      if (!res.ok) throw new Error();

      const data = await res.json();
      counterEnabled = data.configured !== false;

      if (typeof data.count === 'number') {
        animateClacks(data.count);
        clearOptimistic();
      }
    } catch {
      pendingTaps += amount;
    } finally {
      flushInProgress = false;
    }
  }

  function ensureFlushTimer() {
    if (flushTimerId !== null) return;
    flushTimerId = window.setInterval(() => flushTaps(), FLUSH_INTERVAL_MS);
  }

  document.addEventListener('click', () => {
    const next = currentClacks + 1;
    animateClacks(next);

    if (hasLoaded) writeOptimistic(next);

    if (!counterEnabled) return;

    pendingTaps += 1;
    ensureFlushTimer();

    if (pendingTaps >= MAX_BATCH_SIZE) flushTaps();
  });

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') flushTaps(true);
  });
  window.addEventListener('pagehide', () => flushTaps(true));

  loadCount();
</script>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
