---
import * as greatPost from '../content/ferdian.md';
import {ToggleRightIcon, ToggleLeftIcon, ArrowUpRightIcon} from "@phosphor-icons/react";
import { ThemeToggle } from "./ThemeToggle";
import LogoDark from "../assets/hero-dark.svg";
import LogoLight from "../assets/hero-light.svg";
import idss from "../assets/idss.png";
import telkoms from "../assets/telkom.png";

const compiled = await greatPost.compiledContent();
const [research, arces, telkom, udinus, outro] = compiled.split('<hr>');

let clacks = 0;
try {
  const response = await fetch(new URL('/api/tap-counter', Astro.url));
  if (response.ok) {
    const data = await response.json();
    clacks = data.count ?? 0;
  }
} catch {
  clacks = 0;
}
---

<script is:inline>
  const theme = localStorage.getItem("theme") ?? "light";
  if (theme === "dark") document.documentElement.classList.add("dark");
</script>

