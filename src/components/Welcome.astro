---
import * as greatPost from '../content/ferdian.md';
import LogoDark from "../assets/hero-dark.svg";
import LogoLight from "../assets/hero-light.svg";
import idss from "../assets/idss.png";
import telkoms from "../assets/telkom.png";
import {GithubLogoIcon, LinkedinLogoIcon, MailboxIcon } from "@phosphor-icons/react";

const compiled = await greatPost.compiledContent();
const [research, arces, telkom, udinus, outro] = compiled.split('<hr>');
---

<script is:inline>
  const theme = localStorage.getItem("theme") ?? "light";
  if (theme === "dark") document.documentElement.classList.add("dark");
</script>

<div class="flex flex-col gap-5 leading-loose gap-y-10">
	<img id="themelogo" src={LogoDark.src} alt="Hero Image" />
	<div>
		<p class="text-4xl text-center tracking-tight">
			love <strong>crafting</strong> llm into 
		</p>
		<p class="text-4xl text-center tracking-tight">
			<strong>useful</strong> tools 
		</p>
	</div>
	<div class="grid grid-cols-2 max-w-2xl mx-auto gap-7">
		<p class="text-base text-right">
			undergraduate informatics engineering at Dian Nuswantoro University, minoring in ai engineering.
		</p>
		<p class="text-base text-left">
			currently at research assistant at IDSS and Project Lead Intern intern PT. Lumintu Group.
		</p>
	</div>
</div>
<hr class="my-10 mx-auto max-w-2xl">
<div class="max-w-2xl grid grid-cols-1 md:grid-cols-2 leading-loose gap-5 mx-auto text-sm items-center justify-items-center md:items-start md:justify-items-start">
	<img src={idss.src} alt="Research assistant in IDSS" class="order-first md:order-last"/>
	<div class="flex flex-col gap-4">
		<Fragment set:html={research} />
	</div>
</div>
<hr class="my-10 mx-auto max-w-2xl">
<div class="max-w-2xl grid grid-cols-1 leading-loose gap-y-10  mx-auto text-sm">
	<div class="grid md:grid-cols-2  gap-4">
		<Fragment set:html={arces} />
	</div>
</div>
<hr class="my-10 mx-auto max-w-2xl">
<div class="max-w-2xl grid grid-cols-1 md:grid-cols-2 leading-loose gap-5 mx-auto text-sm items-center justify-items-center md:items-start md:justify-items-start">
	<img src={telkoms.src} alt="Intern at telkom" />
	<div class="flex flex-col gap-4">
		<Fragment set:html={telkom} />
	</div>
</div>
<hr class="my-10 mx-auto max-w-2xl">
<div class="max-w-2xl grid grid-cols-1 leading-loose gap-y-10  mx-auto text-sm">
	<div class="grid md:grid-cols-2 gap-4 text-left">
		<Fragment set:html={udinus} />
	</div>
</div>
<hr class="my-10 mx-auto max-w-2xl">
<div class="max-w-2xl grid md:grid-cols-2 leading-loose gap-y-10 gap-5 mx-auto text-base">
	<div class="flex flex-col text-left">
		<Fragment set:html={outro} />
	</div>
	<div class="flex flex-col gap-2 mt-2">
		<div class="flex justify-left gap-5">
			<a href="https://github.com/ferdianfariza" target="_blank" rel="noopener noreferrer" class="cursor-pointer hover:-translate-y-1 hover:opacity-70 transition-all duration-200">
				<GithubLogoIcon size={23}>
				</GithubLogoIcon>
			</a>
			<a href="https://www.linkedin.com/in/ferdian-nur-fariza/" target="_blank" rel="noopener noreferrer" class="cursor-pointer hover:-translate-y-1 hover:opacity-70 transition-all duration-200">
				<LinkedinLogoIcon size={23}>
				</LinkedinLogoIcon>
			</a>
			<a href="mailto:ferdianfariza@gmail.com" class="cursor-pointer hover:-translate-y-1 hover:opacity-70 transition-all duration-200">
				<MailboxIcon size={23}>
				</MailboxIcon>
			</a>
		</div>
	</div>
</div>

<script define:vars={{ logoDarkSrc: LogoDark.src, logoLightSrc: LogoLight.src }}>
  function updateLogo() {
    const isDark = document.documentElement.classList.contains('dark');
    const logoImg = document.getElementById('themelogo');
    if (logoImg) {
      logoImg.src = isDark ? logoDarkSrc : logoLightSrc;
    }
  }

  // Update on page load
  updateLogo();

  // Watch for theme class changes
  const observer = new MutationObserver(updateLogo);
  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class']
  });
</script>