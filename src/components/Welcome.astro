---
import * as greatPost from '../content/ferdian.md';
import {App} from "./tictactoe";
import {ToggleRightIcon, ToggleLeftIcon, ArrowUpRightIcon} from "@phosphor-icons/react";
import { ThemeToggle } from "./ThemeToggle";
import LogoDark from "../assets/hero-dark.svg";
import LogoLight from "../assets/hero-light.svg";

const compiled = await greatPost.compiledContent();
const posts = Object.values(import.meta.glob('../content/*.md', { eager: true }));
const value = 3035
---
<!-- Di <head> layout kamu, WAJIB ada ini agar tidak flash -->
<script is:inline>
  const theme = localStorage.getItem("theme") ?? "light";
  if (theme === "dark") document.documentElement.classList.add("dark");
</script>

<div class="md:border max-w-4xl mx-auto my-10 p-5 text-xs">
	<div class="mb-15">
		<div class="flex justify-between border-y py-2">
			<p>Ferdian N. Fariza</p>
			<div id="clock"></div>
			<ThemeToggle client:load />
		</div>
		<div class="flex justify-between border-b py-2">
			<div class="flex gap-2">
				<p>Let's Connect</p>
				<ArrowUpRightIcon size={10} weight="light" />
			</div>
			<div class="flex gap-2">
				<p>GitHub</p>
				<ArrowUpRightIcon size={10} weight="light" />
			</div>
			<div class="flex gap-2">
				<p>Mail</p>
				<ArrowUpRightIcon size={10} weight="light" />
			</div>
			<div class="flex gap-2">
				<p>Clackz: {value}</p>
			</div>
		</div>
	</div>
	<div class="flex flex-col gap-5 leading-loose gap-y-10">
		<img id="themelogo" src={LogoDark.src} alt="Logo" />
		<div>
			<p class="text-4xl text-center tracking-tight">
				love <strong>crafting</strong> llm into 
			</p>
			<p class="text-4xl text-center tracking-tight">
				<strong>useful</strong> tools 
			</p>
		</div>
		<div class="flex flex-row max-w-3xl mx-auto gap-10">
			<p class="text-base text-right">
				undergraduate informatics engineering at Dian Nuswantoro University, minoring in ai engineering.
			</p>
			<p class="text-base text-left">
				currently at research assistant at IDSS and Project Lead Intern intern PT. Lumintu Group.
			</p>
		</div>
	</div>
</div>

<script>
  import dayjs from "dayjs";

  const clock = document.getElementById("clock");
  let prev = { hh: "", mm: "", ss: "" };

  function part(val, changed) {
    const cls = changed ? "clock-part" : "clock-static";
    return `<span class="${cls}">${val}</span>`;
  }

  function update() {
    const now = dayjs();
    const hh = now.format("HH");
    const mm = now.format("mm");
    const ss = now.format("ss");

    clock.innerHTML =
      part(hh, hh !== prev.hh) +
      `<span>:</span>` +
      part(mm, mm !== prev.mm) +
      `<span>:</span>` +
      part(ss, ss !== prev.ss);

    prev = { hh, mm, ss };
  }

  update();
  setInterval(update, 1000);
</script>

<script define:vars={{ logoDarkSrc: LogoDark.src, logoLightSrc: LogoLight.src }}>
  function updateLogo() {
    const isDark = document.documentElement.classList.contains('dark');
    const logoImg = document.getElementById('themelogo');
    if (logoImg) {
      logoImg.src = isDark ? logoDarkSrc : logoLightSrc;
    }
  }

  // Update on page load
  updateLogo();

  // Watch for theme class changes
  const observer = new MutationObserver(updateLogo);
  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class']
  });
</script>

